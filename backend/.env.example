# Org owner allowlist (chapter pilot)
# Comma-separated emails that may register/login outside @semo.edu and become
# the org owner (e.g. nsa.connect@gmail.com). When set, empty-org bootstrap
# only promotes these emails — SEMO students stay pending until approved.
ORG_OWNER_EMAILS=

# Application
APP_NAME="NSA Connect API"
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nsa_connect

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me-before-production-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Rate limiting (Redis-backed; see app/core/rate_limit.py for IP derivation)
# Behind Railway/CDN set RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_LOGIN_IP_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_FAILURES_MAX=10
RATE_LIMIT_REGISTER_IP_MAX=5
RATE_LIMIT_CHANGE_PASSWORD_MAX=5
RATE_LIMIT_GUEST_CHECKIN_EVENT_IP_MAX=5
RATE_LIMIT_GUEST_CHECKIN_GLOBAL_IP_MAX=30
RATE_LIMIT_GLOBAL_MAX=300
# AI cost controls (per authenticated member)
# RATE_LIMIT_AI_USER_MAX=30
# RATE_LIMIT_AI_USER_WINDOW_SECONDS=3600
# RATE_LIMIT_AI_USER_DAILY_MAX=100
# MAX_REQUEST_BODY_BYTES=36700160
# HSTS_ENABLED=true

# Email (set EMAIL_ENABLED=true in production; Resend sends all outbound mail)
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="NSA Connect <onboarding@resend.dev>"
# When set, all notification emails go here instead of real recipients (dev/testing only)
# MUST be empty in production.
EMAIL_TEST_OVERRIDE_RECIPIENT=

# How long /verify-email?token= links stay valid
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
# Local only: skip the inbox click so SEMO signups go straight to pending.
# Must stay false in production (the API refuses to boot if this is true).
# For local skip-inbox, set SKIP_EMAIL_VERIFICATION=true in backend/.env.
SKIP_EMAIL_VERIFICATION=false

# Web app URL for links in transactional emails
FRONTEND_URL=http://localhost:5173

# Cloudinary (receipts + event photo archive)
# Required in production — leave blank in development to store under backend/dev_uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RECEIPTS_FOLDER=nsa-connect/finance-receipts
CLOUDINARY_EVENT_PHOTOS_FOLDER=nsa-connect/event-photos
CLOUDINARY_MEMBER_AVATARS_FOLDER=nsa-connect/member-avatars
CLOUDINARY_GROUP_AVATARS_FOLDER=nsa-connect/group-avatars

# Used when resolving local dev photo paths for album zip downloads
DEV_UPLOAD_BASE_URL=http://127.0.0.1:8000

# Anthropic AI (set AI_ENABLED=true when ready)
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI embeddings + receipt vision scanning
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini
# Optional: RATE_LIMIT_RECEIPT_SCAN_MAX=10 (per treasurer, per hour)
